# Copy to .env and fill in. Never commit .env.
# Providers are tried in the order listed in CIVICLENS_PROVIDER: first = primary, the rest = fallbacks.
# Options: groq, openrouter, gemini, or "mock" (labeled demonstration fallback, not AI).
CIVICLENS_PROVIDER=groq,openrouter

# Primary: Groq (free key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback: OpenRouter (free key from https://openrouter.ai/keys; pick a vision-capable ":free" model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Reasoning models are much slower (30-75 s per draft measured); leave off unless you want to test with it on.
OPENROUTER_REASONING=off

# Optional: Google Gemini (add "gemini" to CIVICLENS_PROVIDER to use it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
